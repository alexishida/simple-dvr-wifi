{
  "name": "simple-dvr-wifi",
  "version": "0.1.0",
  "description": "Monitoramento local e controle seguro de câmeras IP/Wi-Fi.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "test": "node scripts/run-regression-tests.mjs",
    "test:all": "npm run build && npm test && node scripts/verify-ptz-onvif.mjs && node scripts/electron-security-smoke.mjs && npm run verify:binaries && npm run lint",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "security:smoke": "npm run build && node scripts/electron-security-smoke.mjs",
    "test:ptz": "npm run build && node scripts/verify-ptz-onvif.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fuses:verify": "node scripts/verify-fuses.mjs",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "verify:binaries": "node scripts/verify-media-binaries.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "security:checklist": "node scripts/security-checklist.mjs",
    "release:assets": "node scripts/generate-release-assets.mjs",
    "release:gate": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^13.0.3",
    "onvif": "^0.8.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6"
  }
}
